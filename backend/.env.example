# Copy to .env and fill with real secrets before deploying.
# These are NOT real secrets — only defaults for local development.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/marion_store
NODE_ENV=development

# JWT (use long random strings in production!)
JWT_ACCESS_SECRET=local-dev-access-secret-change-in-production-please
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-production-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Auth
BCRYPT_ROUNDS=10
ALLOW_REGISTRATION=false

# CORS / hosting
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=./uploads

# Rate limits (requests per minute per IP)
RATE_LIMIT_GENERAL=300
RATE_LIMIT_AUTH=10

# Cloudflare R2 (product images, logo, banner — required, the server refuses
# to boot without these). Create an R2 API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_REGION=auto
# Either R2_ENDPOINT or R2_ACCOUNT_ID is required.
R2_ENDPOINT=
# Public base URL of the bucket (e.g. https://cdn.example.com). When empty,
# stored image URLs are presigned and expire after R2_SIGNED_URL_TTL seconds.
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=
R2_SIGNED_URL_TTL=3600
